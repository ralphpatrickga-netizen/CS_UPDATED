# Set these values in your process environment; do not commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret

# Supply these in the process environment for local setup; never commit real values.
FOUNDING_ADMIN_NAME=
FOUNDING_ADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_RESIDENT_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=BarangayConnect <no-reply@example.com>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Public origin used in email links (for example https://barangayconnect.example.org).
APP_BASE_URL=

PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5
ADMIN_OTP_TTL_MINUTES=5
ADMIN_OTP_RESEND_SECONDS=60
ADMIN_OTP_MAX_SENDS_PER_HOUR=5
