# Set these values in your process environment; do not commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret

# Supply these in the process environment for local setup; never commit real values.
FOUNDING_ADMIN_NAME=
FOUNDING_ADMIN_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_RESIDENT_PASSWORD=

# Gmail: use smtp.gmail.com:587 with TLS and a Google App Password.
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your-full-gmail-address
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=BarangayConnect <your-full-gmail-address>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Public origin used in email links (for example https://barangayconnect.example.org).
APP_BASE_URL=

PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5

REGISTRATION_OTP_TTL_MINUTES=10
REGISTRATION_OTP_RESEND_SECONDS=60
REGISTRATION_OTP_MAX_SENDS_PER_HOUR=5
